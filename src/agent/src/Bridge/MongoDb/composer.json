{
    "name": "symfony/ai-mongo-db-message-store",
    "description": "MongoDB message store bridge for Symfony AI Agent",
    "license": "MIT",
    "type": "symfony-ai-message-store",
    "keywords": [
        "ai",
        "bridge",
        "agent",
        "message-store",
        "mongodb"
    ],
    "authors": [
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de"
        },
        {
            "name": "Oskar Stark",
            "email": "oskarstark@googlemail.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "mongodb/mongodb": "^1.21|^2.0",
        "symfony/ai-agent": "^0.16",
        "symfony/ai-platform": "^0.16",
        "symfony/serializer": "^7.3|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53"
    },
    "conflict": {
        "mongodb/mongodb": "<1.21"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Agent\\Bridge\\MongoDb\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Agent\\Bridge\\MongoDb\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
