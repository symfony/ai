{
    "name": "symfony/ai-specstream-tool",
    "description": "SpecStream web search and extract tool bridge for Symfony applications.",
    "license": "MIT",
    "type": "symfony-ai-tool",
    "keywords": [
        "ai",
        "bridge",
        "specstream",
        "agent",
        "tool"
    ],
    "authors": [
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/ai-agent": "^1.0",
        "symfony/http-client": "^7.3|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53",
        "symfony/ai-platform": "^1.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Agent\\Bridge\\SpecStream\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\Agent\\Bridge\\SpecStream\\Tests\\": "Tests/",
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
