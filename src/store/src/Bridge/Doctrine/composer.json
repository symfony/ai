{
    "name": "symfony/ai-doctrine-store",
    "description": "Doctrine ORM vector store bridge for Symfony AI, storing embeddings on the entity's own table",
    "license": "MIT",
    "type": "symfony-ai-store",
    "keywords": [
        "ai",
        "bridge",
        "doctrine",
        "entity",
        "mariadb",
        "orm",
        "pgvector",
        "postgres",
        "store",
        "vector"
    ],
    "authors": [
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.1",
        "doctrine/orm": "^3.4",
        "oskarstark/enum-helper": "^1.5",
        "psr/log": "^3.0",
        "symfony/ai-platform": "^0.15",
        "symfony/ai-store": "^0.15",
        "symfony/http-client-contracts": "^3.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53",
        "symfony/cache": "^7.3|^8.0",
        "symfony/doctrine-bridge": "^7.3|^8.0",
        "symfony/uid": "^7.3|^8.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Store\\Bridge\\Doctrine\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Store\\Bridge\\Doctrine\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
