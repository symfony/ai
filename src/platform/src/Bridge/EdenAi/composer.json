{
    "name": "symfony/ai-eden-ai-platform",
    "description": "Eden AI platform bridge for Symfony AI",
    "license": "MIT",
    "type": "symfony-ai-platform",
    "keywords": [
        "ai",
        "bridge",
        "edenai",
        "gateway",
        "platform"
    ],
    "authors": [
        {
            "name": "Mathieu Santostefano",
            "email": "msantostefano@proton.me"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/ai-generic-platform": "^0.12",
        "symfony/ai-platform": "^0.12",
        "symfony/clock": "^7.3|^8.0",
        "symfony/http-client": "^7.3|^8.0",
        "symfony/mime": "^7.3|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Platform\\Bridge\\EdenAi\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Platform\\Bridge\\EdenAi\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
