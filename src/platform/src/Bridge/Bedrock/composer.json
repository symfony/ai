{
    "name": "symfony/ai-bedrock-platform",
    "description": "AWS Bedrock platform bridge for Symfony AI",
    "license": "MIT",
    "type": "symfony-ai-platform",
    "keywords": [
        "ai",
        "aws",
        "bedrock",
        "bridge",
        "platform"
    ],
    "authors": [
        {
            "name": "Christopher Hertel",
            "email": "mail@christopher-hertel.de"
        },
        {
            "name": "Oskar Stark",
            "email": "oskarstark@googlemail.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "async-aws/bedrock-runtime": "^0.1|^1.0",
        "php": ">=8.2",
        "symfony/ai-anthropic-platform": "^0.12",
        "symfony/ai-meta-platform": "^0.12",
        "symfony/ai-platform": "^0.12"
    },
    "require-dev": {
        "async-aws/sso": "^1.0",
        "async-aws/sso-oidc": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.53",
        "symfony/ai-generic-platform": "^0.12",
        "symfony/ai-open-responses-platform": "^0.12",
        "symfony/console": "^7.3|^8.0"
    },
    "suggest": {
        "async-aws/sso": "Required to authenticate Bedrock Mantle with an AWS SSO profile.",
        "async-aws/sso-oidc": "Required to authenticate Bedrock Mantle with a modern AWS SSO session.",
        "symfony/ai-generic-platform": "Required to use the Bedrock Mantle Chat Completions API.",
        "symfony/ai-open-responses-platform": "Required to use the Bedrock Mantle Responses API."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Symfony\\AI\\Platform\\Bridge\\Bedrock\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\AI\\PHPStan\\": "../../../../../.phpstan/",
            "Symfony\\AI\\Platform\\Bridge\\Bedrock\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "symfony/ai",
            "url": "https://github.com/symfony/ai"
        }
    }
}
