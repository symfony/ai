parameters:
    customRulesetUsed: true

services:
    -
        class: PHPStan\Rules\DisallowedConstructs\DisallowedEmptyRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\ForbidDeclareStrictTypesRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\ForbidNativeExceptionRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\ForbidTestCoverageAttributesRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\Deprecation\AnnouncedMethodCallRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\Deprecation\DeprecationTagFormatRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\Deprecation\DeprecationTriggerRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\Deprecation\TriggerDeprecationArgumentsRule
        tags:
            - phpstan.rules.rule
    -
        class: Symfony\AI\PHPStan\Deprecation\DeprecatedUsageExtension
        tags:
            - phpstan.restrictedMethodUsageExtension
            - phpstan.restrictedClassNameUsageExtension
            - phpstan.restrictedPropertyUsageExtension
            - phpstan.restrictedClassConstantUsageExtension
    -
        class: Symfony\AI\PHPStan\Deprecation\VirtualArgumentIgnoreExtension
        tags:
            - phpstan.ignoreErrorExtension
