{% import "_message.html.twig" as msg %}

<div class="card mx-auto shadow-lg" {{ attributes.defaults(stimulus_controller('mcp')) }}>
    <div class="card-header p-2">
            {{ ux_icon('mcp') }}
            <strong class="ms-1 pt-1 d-inline-block">MCP Client Bot</strong>
        <button {{ live_action('reset') }} class="btn btn-sm btn-outline-secondary float-end">{{ ux_icon('cancel') }} Reset Chat</button>
    </div>
    <div id="chat-body" class="card-body p-4 overflow-auto">
        {% for message in this.messages %}
            {% include '_message.html.twig' with { message, latest: loop.last } %}
        {% else %}
            <div id="welcome" class="text-center mt-5 py-5 bg-white rounded-5 shadow-sm w-75 mx-auto">
                {{ ux_icon('mcp', { height: '200px', width: '200px' }) }}
                <h4 class="mt-5">Remote MCP Servers</h4>
                <span class="text-muted">This bot has no tools of its own - it borrows them from three remote MCP servers.</span>
                <div class="mt-3">
                    {% for server in this.servers %}
                        <span class="badge text-bg-secondary">{{ server }}</span>
                    {% endfor %}
                </div>
                <div class="text-muted small mt-4">
                    Try <em>"Which subway trains leave Times Square right now?"</em>
                </div>
            </div>
        {% endfor %}
        <div id="loading-message" class="d-none">
            {{ msg.user([{text:''}]) }}
            {{ msg.bot('The MCP Bot is asking its servers ...', true) }}
        </div>
    </div>
    <div class="card-footer p-2">
        <form class="input-group" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message"
                   data-model="norender|message"
                   type="text" class="form-control border-0" placeholder="Write a message ...">
            <button class="btn btn-outline-secondary border-0">
                {{ ux_icon('send') }} Submit
            </button>
        </form>
    </div>
</div>
