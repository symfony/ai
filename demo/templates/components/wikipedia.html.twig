{% import '_message.html.twig' as msg %}
{% import 'wikipedia/_research.html.twig' as research %}
{% set messages = this.messages %}

<section class="chat" {{ attributes.defaults(stimulus_controller('wikipedia')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.wikipedia }) }}
    <div id="chat-body" class="chat-body">
        {# Kept across re-renders, so the connection to the Mercure hub stays open #}
        <div id="research-stream" data-live-ignore>{{ turbo_stream_from(this.topic) }}</div>
        {% for message in messages %}
            {% if message.role.value == 'assistant' %}
                {{ research.answer(message) }}
            {% else %}
                {{ msg.user(message.content) }}
            {% endif %}
        {% else %}
            {{ msg.welcome('Wikipedia Research', 'Ask me about any topic - I search and read Wikipedia in a background worker, and you watch every step of my research arrive via Mercure.') }}
        {% endfor %}
        {% if this.researching %}
            {{ research.researching() }}
        {% endif %}
        <div id="loading-message" class="d-none">
            {{ msg.user([{text:''}]) }}
        </div>
    </div>
    <div class="chat-composer" data-controller="chat-prompt">
        {% if messages is empty %}
            {{ include('_chat_prompts.html.twig', { prompts: ['Who created Symfony?', 'What is the Model Context Protocol?', 'Who is the current pope?'] }) }}
        {% endif %}
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message" data-model="norender|message" type="text" class="chat-input" placeholder="What do you want to research?" autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
