<div {{ attributes.defaults({ class: 'row' }) }}>
    <div class="col-4 movie-card-poster">
        {% include 'components/_movie_poster.html.twig' with { movie, aspect: 'auto' } only %}
    </div>
    <div class="col-8 movie-card-scroll-body">
        <h5 class="card-title mb-1">
            {{ movie.title }}{% if movie.year %} <small class="text-muted">({{ movie.year }})</small>{% endif %}
            {% if movie.imdb %}
                <a href="{{ movie.imdb }}" title="{{ movie.title }} on IMDb.com" target="_blank" rel="noopener">
                    {{ ux_icon('streamline-logos:imdb-logo-solid', { height: '30px', width: '30px' }) }}
                </a>
            {% endif %}
        </h5>
        {% if movie.director %}
            <p class="card-text text-muted mb-2">
                <strong>Director:</strong>
                <button type="button" class="movie-name" title="Ask for movies of {{ movie.director }}" data-action="movies#ask" data-movies-prompt-param="{{ movie.director }}">{{ movie.director }}</button>
            </p>
        {% endif %}
        {% if movie.plot|length > 0 %}
            <h6 class="text-dark-emphasis">Plot</h6>
            <div class="card-text small">
                {% for paragraph in movie.plot %}
                    {{ paragraph|markdown_to_html }}
                {% endfor %}
            </div>
        {% endif %}
        {% if movie.cast|length > 0 %}
            <h6 class="text-dark-emphasis mt-3">Cast</h6>
            <ul class="cast-badges list-unstyled mb-0">
                {% for member in movie.cast %}
                    <li class="cast-badge">
                        <button type="button" class="movie-name cast-badge-actor" title="Ask for movies with {{ member.name }}" data-action="movies#ask" data-movies-prompt-param="{{ member.name }}">{{ member.name }}</button>
                        <span class="cast-badge-role">{{ member.role }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
