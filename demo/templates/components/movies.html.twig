{% import '_message.html.twig' as message %}
{% import 'movies/_answer.html.twig' as movies %}
{% set messages = this.messages %}

<section class="chat" {{ attributes.defaults(stimulus_controller('movies')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.movies }) }}
    <div id="chat-body" class="chat-body">
        {# Kept across re-renders, so the connection to the Mercure hub stays open #}
        <div id="movie-stream" data-live-ignore>{{ turbo_stream_from(this.topic) }}</div>
        {% for msg in messages %}
            {% if msg.role.value == 'assistant' %}
                {{ movies.answer(msg, this.getMoviesFor(msg)) }}
            {% else %}
                {{ message.user(msg.content) }}
            {% endif %}
        {% else %}
            {{ message.welcome('Chat about movies', 'Search for movies in our collection by title, director, cast or vibe - a background worker streams the answer via Mercure, with the movie cards and the tool calls of the agent.') }}
        {% endfor %}
        {% if this.answering %}
            {{ movies.answering() }}
        {% endif %}
        <div id="loading-message" class="d-none">
            {{ message.user([{text:''}]) }}
        </div>
    </div>
    {% set detailMovie = this.detailMovie %}
    {% if detailMovie %}
        <div class="movie-modal-overlay">
            <button type="button" class="movie-modal-backdrop" {{ live_action('closeDetails') }} aria-label="Close details"></button>
            <div class="movie-modal-panel">
                <button type="button" class="movie-modal-close" {{ live_action('closeDetails') }} aria-label="Close">&times;</button>
                {{ component('movie_card', { movie: detailMovie }) }}
            </div>
        </div>
    {% endif %}
    <div class="chat-composer" data-controller="chat-prompt">
        {{ include('_chat_prompts.html.twig', { prompts: ['Movies by Christopher Nolan', 'Something with Tom Hanks', 'Something about the mafia'] }) }}
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message" data-model="norender|message" type="text" class="chat-input" placeholder="What kind of movie are you looking for?" autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
