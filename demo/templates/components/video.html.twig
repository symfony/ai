<section class="chat" {{ attributes.defaults(stimulus_controller('video')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.video, reset: false }) }}
    <div id="chat-body" class="chat-body">
        <div id="welcome" class="message message-bot">
            <span class="bot avatar">{{ ux_icon('bot') }}</span>
            <div class="welcome-content">
                <h4>What does your webcam see?</h4>
                <p>Allow access to your webcam and ask me something - I analyze the current frame with a vision model.</p>
                <video id="videoFeed" class="video-feed" autoplay playsinline></video>
                <canvas id="canvas" class="d-none"></canvas>
                <div class="video-caption">
                    <div id="video-caption" data-loading="action(submit)|hide">{{ this.caption|markdown_to_html }}</div>
                    <div data-loading="action(submit)|show" class="video-caption-loading">
                        <span class="typing" aria-hidden="true"><span></span><span></span><span></span></span>
                        <i>Analyzing the frame…</i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="chat-composer" data-controller="chat-prompt">
        {{ include('_chat_prompts.html.twig', { prompts: ['What am I holding?', 'Describe the room', 'How many people do you see?'] }) }}
        <form class="chat-form" data-action="submit->video#submit">
            <input autofocus id="chat-message"
                   data-model="norender|instruction"
                   data-loading="action(submit)|addAttribute(disabled)"
                   type="text" class="chat-input" placeholder="What should I look for?" autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send" data-loading="action(submit)|addAttribute(disabled)">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
